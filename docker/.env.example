# Copy to docker/.env and fill in your keys before running
# docker compose --env-file docker/.env -f docker/docker-compose.yml up -d gemma4

# ── Google AI Studio (Gemma 4 / Gemini) ──────────────────────────────────────
# Get free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemma-4-27b-it        # or gemma-4-9b-it (faster) or gemini-2.0-flash

# ── Together AI (Gemma 4 27B, higher RPM than free Gemini) ───────────────────
# Get key: https://api.together.xyz
TOGETHER_API_KEY=your_together_key_here
TOGETHER_MODEL=google/gemma-4-27b-it

# ── Groq (Gemma 2 9B, fastest inference, 30 RPM free tier) ──────────────────
# Get key: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# ── Open5GS WebUI credentials (match your native setup) ──────────────────────
WEBUI_USER=admin
WEBUI_PASSWORD=1423
